{
  "name": "Fastly Fanout Chat Workshop",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    // The Fastly CLI and js-compute toolchain need Node 20+. The CLI itself is
    // pinned as an npm dependency in edge/package.json, so there's nothing to
    // install globally.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  // Installs project dependencies and pre-builds the Wasm package. This runs
  // once when the container is created — and is baked into the image if the
  // repo has Codespaces prebuilds enabled, which makes attendee start-up fast.
  "onCreateCommand": "bash .devcontainer/setup.sh",

  // Starts the origin and edge apps. Runs on every attach; the script is
  // idempotent, so reconnecting just tails the existing logs.
  "postAttachCommand": "bash scripts/dev.sh",

  "forwardPorts": [7676, 3000],
  "portsAttributes": {
    "7676": {
      "label": "Chat app (Compute + Fanout)",
      "onAutoForward": "openPreview"
    },
    "3000": {
      "label": "Django origin (direct)",
      "onAutoForward": "silent"
    },
    // Pushpin's own ports. Traffic reaches these from inside the container
    // only, so there's no reason to forward them.
    "7677": {
      "label": "Pushpin proxy (internal)",
      "onAutoForward": "ignore"
    },
    "5561": {
      "label": "Pushpin publish (internal)",
      "onAutoForward": "ignore"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/origin/venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
